# syntax=docker/dockerfile:1.7
# NOTE: release image for the cc-switch-web fork. Not yet build-tested in CI
# (the builder needs the full Tauri Linux toolchain); validated path is
# scripts/install-server.sh + systemd on the Tailscale host itself.

FROM rust:1.85-bookworm AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential curl file libssl-dev libgtk-3-dev \
      libayatana-appindicator3-dev librsvg2-dev libwebkit2gtk-4.1-dev \
      ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://get.pnpm.io/install.sh | ENV="$HOME/.shrc" SHELL="$(which sh)" sh - \
  && ln -s /root/.local/share/pnpm/pnpm /usr/local/bin/pnpm
WORKDIR /build
COPY . .
RUN pnpm install && pnpm build:web \
  && cd src-tauri && cargo build --release --example server \
  && cp target/release/examples/server /usr/local/bin/cc-switch-web

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates libssl3 libgtk-3-0 libayatana-appindicator3-1 \
      librsvg2-2 libwebkit2gtk-4.1-0 \
    && rm -rf /var/lib/apt/lists/*
RUN useradd -m ccswitch
COPY --from=builder /build/dist-web /home/ccswitch/dist-web
COPY --from=builder /usr/local/bin/cc-switch-web /usr/local/bin/cc-switch-web
USER ccswitch
WORKDIR /home/ccswitch
ENV HOST=0.0.0.0 PORT=18766 TRUSTED_TAILNET=1 \
    CC_SWITCH_CONFIG_DIR=/home/ccswitch/.cc-switch-web \
    WEB_DIST=/home/ccswitch/dist-web
EXPOSE 18766
CMD ["cc-switch-web"]
